# RecallOps AI Backend Environment Configuration

# Groq LLM Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Persistent Memory Configuration
# Point to your local Hindsight server (e.g. http://localhost:8888) or Hindsight Cloud
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recallops-org-memory

# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
